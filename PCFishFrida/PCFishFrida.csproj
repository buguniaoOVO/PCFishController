<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PCFishFrida</AssemblyName>
    <RootNamespace>PCFishFrida</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Frida.NET" Version="17.24.3" />
    <PackageReference Include="Frida.NET.Runtime.win-x64" Version="17.24.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\PCFishController\FridaAgent\pcfish-agent.js" LogicalName="PCFishFrida.pcfish-agent.js" />
  </ItemGroup>

</Project>
